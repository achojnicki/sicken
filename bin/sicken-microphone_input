#!/usr/bin/env python3

from adistools.adisconfig import adisconfig
from sicken.log import Log
from sicken.events import events

from sicken.DB import DB

from pika import BlockingConnection, PlainCredentials, ConnectionParameters
from speech_recognition import Recognizer, Microphone
from uuid import uuid4
from time import time
from os import environ

class microphone_input:
    project_name="sicken-microphone_input"
    def __init__(self):
        self._active=True

        self._config = adisconfig('/opt/sicken/configs/sicken-microphone_input.yaml')
        self._log = Log(
            parent=self,
            rabbitmq_host=self._config.rabbitmq.host,
            rabbitmq_port=self._config.rabbitmq.port,
            rabbitmq_user=self._config.rabbitmq.user,
            rabbitmq_passwd=self._config.rabbitmq.password,
            debug=self._config.log.debug,
        )

        self._recognizer = Recognizer()
        self._events=events(self)
        self._db=DB(self)

        environ["OPENAI_API_KEY"]=self._config.openai.api_key

    def start(self):
        self.listen()
    
    def stop(self):
        self.active=False


    def listen(self):
        chat_uuid=str(uuid4())
        self._db.create_chat(
            chat_uuid=chat_uuid,
            chat_created=time()
            )

        with Microphone() as source:
            print('Calibrating microphone...')
            self._recognizer.adjust_for_ambient_noise(source)
            print('Ready.')
            
            while self._active:
                print('Listening...')  
                audio = self._recognizer.listen(source)
                if audio:
                    try:
                        text=self._recognizer.recognize_openai(audio, language='en', temperature=0.01)

                        print(text)
                        if text:
                            self._events.event(
                                event_name="speech_recognized",
                                event_data={
                                    "chat_uuid": chat_uuid,
                                    "message_author": "Message from sicken-microphone_input command line tool.",
                                    "message": text 
                                    }
                                )
                    except:
                        print('error')


if __name__=="__main__":
    worker=microphone_input()
    worker.start()